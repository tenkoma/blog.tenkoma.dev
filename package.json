{
  "name": "blog-template",
  "version": "0.0.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "test:security": "node --test tests/http-cache-semantics.test.mjs",
    "postinstall": "patch-package --error-on-fail",
    "prepare": "husky"
  },
  "dependencies": {
    "@astro-community/astro-embed-utils": "^0.2.0",
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-custom-embeds": "^0.0.1",
    "astro-og-canvas": "^0.13.2",
    "cheerio": "^1.2.0",
    "lite-youtube-embed": "^0.3.4",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "svelte": "^5.57.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pagefind": "^1.5.2",
    "patch-package": "^8.0.1",
    "vite-plugin-pagefind": "^1.1.2"
  },
  "overrides": {
    "@shikijs/types": "4.3.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    },
    "http-cache-semantics": "4.3.0",
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "speech-rule-engine": {
      "@xmldom/xmldom": "0.9.12"
    },
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mdx,css}": "oxfmt --write",
    "!(*-lock).json": "oxfmt --write"
  }
}
